{
  "name": "fynd-hackathon-checkout",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Mini checkout (Next.js + Zustand) with Playwright browser tests and a manual test plan.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:e2e": "cross-env NEXT_PUBLIC_PLAYWRIGHT_TEST=1 NEXT_DIST_DIR=.next-e2e next build",
    "start:e2e": "cross-env NEXT_DIST_DIR=.next-e2e next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "@playwright/test": "1.65.1",
    "cross-env": "10.1.0"
  }
}
